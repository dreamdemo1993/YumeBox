<!--
  Expanded body of the ongoing notification. It is a RemoteViews layout instead of a notification
  action row on purpose: ColorOS (and some other ROMs) render any ongoing notification that carries
  an action in its expanded form, which put the stop button on screen from the moment a session
  started. Nothing here is inflated until the user opens the entry.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/notification_expanded_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/notification_expanded_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notification_expanded_usage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/notification_expanded_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/notification_expanded_node"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/notification_expanded_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/notification_expanded_stop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_notification_stop"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:textColor="@color/notification_expanded_accent"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
